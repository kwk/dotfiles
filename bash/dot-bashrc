# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/scripts:$HOME/.local/bin:$HOME/bin:$HOME/bin/google-cloud-sdk/bin" ]]
then
    PATH="$HOME/.local/scripts:$HOME/.local/bin:$HOME/bin:$PATH:$HOME/bin/google-cloud-sdk/bin"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi

unset rc

#PS1='\w > '
PS1="\n\$([[ \"\${TMUX}\" == \"\" ]] && echo '\[\e[2m\] \u 󰲝 \h\[\e[0m\]\[\e[1m\] ')  \w\[\e[0m\] > "

if [[ -e ~/.extra-bashrc ]]; then
	source ~/.extra-bashrc
fi

if [[ -e ~/.local/scripts/git-prompt.sh ]]; then
	# Show a '*' if repo is in dirty state
	GIT_PS1_SHOWDIRTYSTATE=1
	# Show a '$' if something is stashed
	GIT_PS1_SHOWSTASHSTATE=
	# Show a '%' if there are untracked files
	GIT_PS1_SHOWUNTRACKEDFILES=
        # Separator for the  
	#GIT_PS1_STATESEPARATOR="  "
	GIT_PS1_STATESEPARATOR=
        # Use colors to indicated git status
        GIT_PS1_SHOWCOLORHINTS=1
	source ~/.local/scripts/git-prompt.sh
        PS1="\n\$([[ \"\${TMUX}\" == \"\" ]] && echo '\[\e[2m\] \u 󰲝 \h\[\e[0m\]\[\e[1m\] ')  \w\[\e[0m\]\[\e[2m\]\$(__git_ps1 \"  %s\")\[\e[0m\] > "
fi

function find_failed_llvm_tests_in_log() {
  grep -Pzo "(?s)\*{20} TEST .*?\n--\n.*?\n--\n" $1
}

function find_failed_llvm_tests_in_log_as_markdown() {
  find_failed_llvm_tests_in_log $1 | sed -E 's/(\*{20} TEST)/````````\n````````\n\1/' | sed -zE 's/\0/\n/' | tr '\0' '\n' 
  echo -e '\n````````\n'
}


PATH="$PATH:~/scripts:~/.cargo/bin:~/go/bin:"
export EDITOR=vim

alias git_last_commit_as_branch='git log --pretty=format:'%s' -n1 | tr " " "_"'

export PATH=$PATH:$HOME/.npm-global/bin

# Yubikey config
[ -f "~/.config/gnupg-yubikey/env.sh" ] && . "~/.config/gnupg-yubikey/env.sh"

# Bitwarden Session key
[ -f "~/.bw.sh" ] && . "~/.bw.sh"

# Testing farm config
[ -f "~/.config/testing-farm/env.sh" ] && . "~/.config/testing-farm/env.sh"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '~/bin/google-cloud-sdk/path.bash.inc' ]; then . '~/bin/google-cloud-sdk/path.bash.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '~/bin/google-cloud-sdk/completion.bash.inc' ]; then . '~/bin/google-cloud-sdk/completion.bash.inc'; fi

[ -f "~/.config/claude-code-vertex/env.sh" ] && . "~/.config/claude-code-vertex/env.sh"
