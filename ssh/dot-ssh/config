Include ~/.ssh/fedora-rhel-config

# Red Hat bastions use GSSAPI, not pubkey — prevent agent key flooding
# This prevents from such error:
#
#    Received disconnect from 10.4.224.4 port 22:2: Too many authentication failures                                     
#    Disconnected from 10.4.224.4 port 22
#    Connection closed by UNKNOWN port 65535
#
Host rdu2 iad2 ams2 pnq2 sin2 us-east-1 us-west-2 eu-central-1 ap-southeast-1
  PubkeyAuthentication  no

# GitHub and GitLab
Host github.com gitlab.com
  User                  git
  # First option:
  IdentitiesOnly        yes
  IdentityFile          ~/.ssh/id_gpg.pub
  # Second option:
  # IdentitiesOnly      no
  # IdentityAgent       /run/user/1000/gnupg/S.gpg-agent.ssh

Host pkgs.fedoraproject.org
  User                  kkleine
  IdentitiesOnly        yes
  IdentityFile          ~/.ssh/id_gpg.pub

Host gitlab.cee.redhat.com
  User                  git
  IdentitiesOnly        yes
  IdentityFile          ~/.ssh/id_gpg.pub

# ITUP.Scale RDU3 host
Host kkleine-llvm
  HostName              10.5.226.75
  User                  fedora
  ProxyJump             rdu2
  IdentitiesOnly        yes
  IdentityFile          ~/.ssh/id_ed25519.pub
  AddressFamily         inet
  GSSAPIAuthentication  no

