{
    "workbench.iconTheme": "vscode-icons",
    "redhat.telemetry.enabled": false,

    "testing.displayedCoveragePercent": "minimum",
    "testing.showCoverageInExplorer": true,
    "coverage-gutters.showGutterCoverage": true,
    "coverage-gutters.showLineCoverage":true,
    "coverage-gutters.coverageFileNames":[
        "lcov.info",
        "cov.xml",
        "coverage.xml",
        "cobertura.xml",
        "jacoco.xml",
        "coverage.cobertura.xml"
    ],
    "coverage-gutters.coverageBaseDir": "/home/kkleine/src/llvm-snapshots",
    "coverage-gutters.manualCoverageFilePaths": ["/home/kkleine/src/llvm-snapshots/coverage.xml"],
    // Python stuff
    // ---
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "mypy-type-checker.args": [
        "--strict",
        "--ignore-missing-imports"
    ],
    // ---
    "files.associations": {
        "*.fmf": "yaml",
        "*.spec.inc": "rpmspec"
    },
    "editor.renderControlCharacters": false,

    "zenMode.hideLineNumbers": false,


    // Shrink space next to editor by removing line numbers and the
    // ability to set breakpoints as well as removing the folding. 
    "editor.lineNumbers": "on",
    "editor.fontFamily": "Mona",
    "editor.glyphMargin": true,
    "editor.folding": false,
    "editor.showFoldingControls": "always",
    "editor.foldingHighlight": false,
    "editor.defaultFoldingRangeProvider": "maptz.regionfolder",
    "maptz.regionfolder": {
        // "[rpmspec]": {                                      //Language selector
        //     "foldEnd": "#endregion",                    //Text inserted at the end of the fold
        //     "foldEndRegex": "#endregion",          //Regex used to find fold end text.
        //     "foldStart": "#region [NAME]",              //Text inserted at the start of the fold.
        //                                                 //Use the `[NAME]` placeholder to indicate
        //                                                 //where the cursor should be placed after
        //                                              //insertion
        //     "foldStartRegex": "#region[\\s]*(.*)",  ////Regex used to find fold start text.
        //     "disableFolding": false //Turn off #region folding for this language
        // },
        "[python]": {                                      //Language selector
            "foldEnd": "# endregion",                    //Text inserted at the end of the fold
            "foldEndRegex": "# endregion",          //Regex used to find fold end text.
            "foldStart": "# region [NAME]",              //Text inserted at the start of the fold.
                                                    //Use the `[NAME]` placeholder to indicate
                                                    //where the cursor should be placed after
                                                    //insertion
            "foldStartRegex": "# region[\\s]*(.*)",  ////Regex used to find fold start text.
            "disableFolding": false //Turn off #region folding for this language
        }
    },
    
    "breadcrumbs.enabled": true,
    "vsicons.dontShowNewVersionMessage": true,
    "zenMode.silentNotifications": true,
    "editor.inlineSuggest.enabled": true,
    "gitlens.defaultTimeFormat": null,
    "gitlens.defaultDateShortFormat": null,
    "editor.renderWhitespace": "selection",
    
    
    //--------------------------------------------------------------------------
    //              Formatting
    //--------------------------------------------------------------------------
    "clang-format.language.cpp.style": "LLVM",
    "clang-format.language.c.style": "LLVM",
    "editor.defaultFormatter": "xaver.clang-format",
  
    "zenMode.hideStatusBar": false,
    "editor.guides.indentation": true,
    "python.diagnostics.sourceMapsEnabled": true,
    // "python.linting.flake8Enabled": true,
    // "python.linting.flake8Args": [
    //     "--per-file-ignores=\"__init__.py:F401\""
    // ],
    "githubPullRequests.pullBranch": "never",
    "go.useLanguageServer": true,
    "[go]":{
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
    },
    "go.testFlags": [
        "-v"
    ],
    "plantuml.previewAutoUpdate": true,
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    // "workbench.colorTheme": "Default Dark+",
    "git.openRepositoryInParentFolders": "always",
    "notebook.lineNumbers": "on",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.mouseWheelZoom": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.foldingStrategy": "indentation",
    "explicitFolding.rules": [

    ],
    "zenMode.showTabs": "single",
    "zenMode.centerLayout": false,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "codecov.coverage.enabled": false,
    "telemetry.telemetryLevel": "off",
    "gitlens.autolinks": [
        {
            "prefix": "RHEL-",
            "url": "https://issues.redhat.com/browse/RHEL-<num>"
        }
    ],
    "granite.localModelSize": "small",
    "notebook.defaultFormatter": "ms-python.black-formatter",
    "python.analysis.typeEvaluation.strictParameterNoneValue": false,
    "python.analysis.typeEvaluation.analyzeUnannotatedFunctions": false,
    "workbench.startupEditor": "none",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.minimap.enabled": false,
    "docker.extension.enableComposeLanguageServer": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "yaml.schemas": {
        "file:///home/kkleine/.vscode/extensions/atlassian.atlascode-4.0.7/resources/schemas/pipelines-schema.json": "bitbucket-pipelines.yml"
    },
    "atlascode.bitbucket.enabled": false,
    "atlascode.jira.statusbar.enabled": true,
    "claudeCode.environmentVariables": [
        {
            "name": "CLAUDE_CODE_USE_VERTEX",
            "value": "1"
        },
        {
            "name": "CLOUD_ML_REGION",
            "value": "us-east5"
        },
        {
            "name": "ANTHROPIC_VERTEX_PROJECT_ID",
            "value": "itpc-gcp-core-pe-eng-claude"
        }
    ],
    "claudeCode.selectedModel": "default",
    "claudeCode.useTerminal": true,
    "claudeCode.preferredLocation": "sidebar",
    //--------------------------------------------------------------------------
    //              CMake
    //--------------------------------------------------------------------------
    "cmake.configureOnOpen": true,
    "cmake.options.statusBarVisibility": "visible",
    "cmake.generator": "Ninja",
    "cmake.sourceDirectory": "${workspaceFolder}/llvm/",
    "cmake.buildDirectory": "${workspaceFolder}/build-${buildType}",
    "cmake.useCMakePresets": "never",
    "cmake.buildEnvironment": {
        //"LIT_FILTER": "Flang :: Lower/location.f90"
        "LIT_FILTER": "flang/test/driver/gcc-triple.f90"
    },
