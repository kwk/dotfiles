    "codechecker.backend.compilationDatabasePath": "${workspaceFolder}/build-RelWithDebInfo/compile_commands.json",
    "codechecker.executor.enableNotifications": true,
    // llvm-vs-code-extensions.vscode-clangd
    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}/build-${buildType}"
    ] ,
    // see https://llvm.github.io/clangir/GettingStarted/contrib.html
    "C_Cpp.intelliSenseEngine": "disabled",

    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.wordWrap": "on",
    "editor.bracketPairColorization.enabled": true,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "chat.mcp.gallery.enabled": true,
    "workbench.experimental.modernUI": true,
}